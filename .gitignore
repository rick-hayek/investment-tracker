# ==========================================
# Investment Tracker - .gitignore
# Tailored for Expo SDK 52+ / React Native / TypeScript
# ==========================================

# Expo & Metro Bundler
.expo/
.expo-shared/
dist/
web-build/
metro-cache/
*.jsbundle

# Native generated builds (Expo Continuous Native Generation - CNG)
# /android/ (tracked for custom build.gradle & release signing)
/ios/

# Android build outputs & caches (if native directory is tracked)
android/build/
android/app/build/
android/.gradle/
android/.cxx/
android/local.properties
*.iml
*.hprof

# iOS build outputs & CocoaPods (if native directory is tracked)
ios/build/
ios/Pods/
ios/Pods.xcodeproj/
*.xcworkspace/
xcuserdata/

# Dependencies
node_modules/
.pnp
.pnp.js

# Testing & Coverage
coverage/
*.lcov
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.pem
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# OS & Editor
.DS_Store
**/.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Temporary & Build outputs
*.tsbuildinfo
.eslintcache
.stylelintcache
*.tgz
